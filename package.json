{
  "name": "@mrchartist/chartist-lite",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "A small, fast canvas financial chart with no runtime dependencies.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "unpkg": "./dist/chartist-lite.iife.min.js",
  "jsdelivr": "./dist/chartist-lite.iife.min.js",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./indicators": {
      "types": "./dist/types/indicators/index.d.ts",
      "import": "./dist/indicators.js"
    },
    "./element": {
      "types": "./dist/types/element/index.d.ts",
      "import": "./dist/element.js"
    },
    "./react": {
      "types": "./dist/types/react/index.d.ts",
      "import": "./dist/react.js"
    },
    "./iife": "./dist/chartist-lite.iife.min.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md",
    "PROVENANCE.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "size": "node scripts/size.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run size"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.25.12",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  }
}
